# Chaves de demonstração. Troque-as antes de qualquer implantação.
CLIENT_API_KEY=grupo8-demo-key
INTERNAL_API_KEY=grupo8-internal-key
TELEMETRY_URL=http://telemetry-service:8001
ALERT_URL=http://alert-service:8002
SERVICE_TIMEOUT_SECONDS=3
RETRY_INTERVAL_SECONDS=30
PENDING_RETRY_BATCH_SIZE=20
# Tempo máximo sem uma leitura; cada leitura funciona como heartbeat do sensor.
SENSOR_OFFLINE_THRESHOLD_SECONDS=300
